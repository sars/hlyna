# HTTPS in front of the app. Certificates are issued automatically once the
# A records point here and ports 80/443 are open.

{
	log {
		output stdout
		format json
	}
}

# Secondary names: one permanent hop to the primary domain.
www.hlyna.com.ua, hlyna.com, www.hlyna.com {
	redir https://hlyna.com.ua{uri} permanent
}

hlyna.com.ua {
	encode zstd gzip

	# HSTS lives here, never in the app, so it is not sent on http://localhost.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Fingerprinted / immutable assets.
	@immutable path /_next/static/*
	header @immutable >Cache-Control "public, max-age=31536000, immutable"

	request_body {
		max_size 25MB
	}

	# Access log in the caddy_data volume, so it outlives container restarts: ~90 days, gzipped when rolled.
	# It is the only record of crawlers and LLM bots (GA sees only browsers). Read it with
	# `docker compose exec caddy sh -c 'zcat -f /data/access/hlyna*.log*'`.
	log {
		output file /data/access/hlyna.log {
			roll_size 50MiB
			roll_keep 60
			roll_keep_for 2160h
		}
		format json
	}

	# Uploaded images straight from the media volume (the app writes them there). /api/media/file/* is the
	# Old (pre-2026-10-12) address of the same files: one permanent hop to /media/*.
	@legacyMedia path_regexp legacyMedia ^/api/media/file/(.+)$
	redir @legacyMedia /media/{re.legacyMedia.1} permanent
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=2592000"
		header X-Content-Type-Options nosniff
		file_server
	}

	# lb_try_duration holds requests for a few seconds while the app restarts.
	# While the app restarts after a deploy, answer with a short branded page instead of a blank 502.
	handle_errors 502 503 504 {
		header Content-Type "text/html; charset=utf-8"
		header Retry-After "10"
		respond `<!doctype html><html lang="uk"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="refresh" content="10"><title>Глина — оновлюємо сайт</title><body style="margin:0;background:#f3e7da;color:#2a2018;font-family:system-ui,sans-serif"><main style="max-width:640px;margin:0 auto;padding:64px 16px"><p style="color:#b4683f;font-weight:700;letter-spacing:2px;text-transform:uppercase;font-size:13px">глина</p><h1>Оновлюємо сайт</h1><p style="font-size:18px;color:#6c5243">Сторінка відкриється за кілька секунд — вона оновиться сама.</p></main></body></html>` 503
	}

	reverse_proxy app:3000 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}
