# Local dev: Postgres on your machine.
# In production compose.yaml overrides DATABASE_URL to point at the db container.
DATABASE_URL=postgresql://127.0.0.1:5432/hlyna

# Production only: password of the db container (compose.yaml builds DATABASE_URL from it).
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Used to encrypt JWT tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash.
# Production: https://hlyna.com.ua
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Telegram notifications about new requests (optional; notifications are skipped if empty)
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat/group/channel ID that receives the notifications (e.g. -1001234567890)
TELEGRAM_CHAT_ID=

# Better Auth (phase 2 of replacing Payload): signs session cookies. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public origin used in auth links; defaults to NEXT_PUBLIC_SERVER_URL
BETTER_AUTH_URL=
