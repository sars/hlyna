# Local development: Postgres on this machine (schema `app`, migrations with `pnpm db:migrate`).
DATABASE_URL=postgresql://127.0.0.1:5432/hlyna

# Public origin of the site, no trailing slash: absolute links, metadata, Telegram buttons. Inlined at build time.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Better Auth (sessions for /panel and /kabinet). Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Origin used in auth links; defaults to NEXT_PUBLIC_SERVER_URL
BETTER_AUTH_URL=

# POST /revalidate?secret=… refreshes every catalogue page (deploy/push.sh and the data scripts call it).
REVALIDATE_SECRET=

# Telegram: notifications about requests, claims and owner edits; buttons answered by /api/telegram/webhook.
# Empty token = notifications are skipped. Webhook registration: docs/studio-owners.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Production only (compose.yaml) ---
# Password of the db container; compose builds DATABASE_URL from it. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Set by compose: MEDIA_DIR=/app/public/media (uploaded photos), IG_STATUS_DIR=/app/ops/instagram (Instagram status
# files for /panel/instagram). KABINET_FROZEN=1 pauses owner saves during maintenance. DB_POOL_MAX (default 10).

# Site chat (src/chat): the assistant answers from the catalogue through the OpenAI API; without a key the pages
# show the request form instead. CHAT_ENABLED=0 switches the chat off with the key present.
OPENAI_API_KEY=
CHAT_MODEL=gpt-5.5
CHAT_DAILY_TURNS=300
# The bot's @username for «Продовжити в Telegram» (looked up with getMe when empty).
TELEGRAM_BOT_USERNAME=
